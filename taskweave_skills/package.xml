<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypelocation="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>taskweave_skills</name>
  <version>0.1.0</version>
  <description>Generic, robot-agnostic taskweave skills (wait, navigate_to, go_to_point).</description>
  <maintainer email="f.rzepczyk@gmail.com">Florian Rzepczyk</maintainer>
  <license>TBD</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>taskweave_core</exec_depend>
  <exec_depend>taskweave_interfaces</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>nav2_msgs</exec_depend>   <!-- navigate_to through Nav2 (taskweave_skills.nav2) -->
  <exec_depend>moveit_msgs</exec_depend>   <!-- tool poses through IK (taskweave_skills.ik) -->
  <exec_depend>python3-numpy</exec_depend>
  <test_depend>rclpy</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
