<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypelocation="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>taskweave_robots</name>
  <version>0.2.2</version>
  <description>taskweave robot packs (data only): per robot model its profile, embodiment, MoveIt config, navigation, sim asset section and named poses, nothing about a cell. Installed to share/taskweave_robots/&lt;robot&gt;/.</description>
  <maintainer email="f.rzepczyk@gmail.com">Florian Rzepczyk</maintainer>
  <!-- vendor-derived robot data (URDF, meshes, limits from the Galbot / Agibot simulation assets): internal use only,
       see each pack's LICENSE-NOTE.md; check the vendor asset licence before this package is shared -->
  <license>Proprietary – internal use (vendor-derived data, see LICENSE-NOTE.md)</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- the pack tests load the packs through taskweave_core and check them against the skills -->
  <test_depend>ament_cmake_pytest</test_depend>
  <test_depend>taskweave_core</test_depend>
  <test_depend>taskweave_skills</test_depend>
  <test_depend>python3-pytest</test_depend>
  <test_depend>python3-yaml</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
