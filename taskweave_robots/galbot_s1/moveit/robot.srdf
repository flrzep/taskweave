<?xml version="1.0"?>
<!-- MoveIt semantics for the Galbot S1 (robot.urdf is generated by tools/model_to_urdf.py). Planning frame: world
     (the cell frame; base_link, the column base, is placed by the virtual joint below). Arm chains start at the
     arms' mount on the lifting torso, so the lift is part of the robot state but not of the arm groups: poses set
     it, IK solves the arms for it. -->
<robot name="galbot_s1">
  <!-- the base in the cell: MoveIt takes world -> base_link from TF, so the planning scene (ros/planning_scene.py,
       frame world) is where the robot really stands -->
  <virtual_joint name="world_joint" type="floating" parent_frame="world" child_link="base_link"/>
  <group name="left_arm">
    <chain base_link="Arms_base_link" tip_link="left_link7"/>
  </group>
  <group name="right_arm">
    <chain base_link="Arms_base_link" tip_link="right_link7"/>
  </group>
  <!-- same chains with a global IK solver (kinematics.yaml): the fallback when no local descent reaches a target -->
  <group name="left_arm_global">
    <chain base_link="Arms_base_link" tip_link="left_link7"/>
  </group>
  <group name="right_arm_global">
    <chain base_link="Arms_base_link" tip_link="right_link7"/>
  </group>
  <group name="torso">
    <joint name="body_joint"/>
  </group>
  <!-- everything a named pose moves: planned as one, so the arms avoid each other, the body and the head -->
  <group name="whole_body">
    <group name="left_arm"/>
    <group name="right_arm"/>
    <group name="torso"/>
    <group name="head"/>
  </group>
  <group name="head">
    <joint name="head_joint1"/>
    <joint name="head_joint2"/>
  </group>
  <!-- disabled collisions: generated by tools/collision_matrix.py -->
  <disable_collisions link1="Arms_Gripper_Ge103In_Right_base_link" link2="Arms_Gripper_Ge103In_Right_left_active_link1" reason="Adjacent"/>
  <disable_collisions link1="Arms_Gripper_Ge103In_Right_base_link" link2="Arms_Gripper_Ge103In_Right_left_passive_link" reason="Adjacent"/>
  <disable_collisions link1="Arms_Gripper_Ge103In_Right_base_link" link2="right_link6" reason="Adjacent"/>
  <disable_collisions link1="Arms_Gripper_Ge103In_Right_base_link" link2="right_link7" reason="Adjacent"/>
  <disable_collisions link1="Arms_Gripper_Ge103In_Right_left_active_link1" link2="Arms_Gripper_Ge103In_Right_left_active_link2" reason="Adjacent"/>
  <disable_collisions link1="Arms_Gripper_Ge103In_Right_left_active_link1" link2="right_link7" reason="Adjacent"/>
  <disable_collisions link1="Arms_Gripper_Ge103In_Right_left_passive_link" link2="right_link7" reason="Adjacent"/>
  <disable_collisions link1="Arms_Gripper_Ge103In_base_link" link2="Arms_Gripper_Ge103In_left_active_link1" reason="Adjacent"/>
  <disable_collisions link1="Arms_Gripper_Ge103In_base_link" link2="Arms_Gripper_Ge103In_left_passive_link" reason="Adjacent"/>
  <disable_collisions link1="Arms_Gripper_Ge103In_base_link" link2="left_link6" reason="Adjacent"/>
  <disable_collisions link1="Arms_Gripper_Ge103In_base_link" link2="left_link7" reason="Adjacent"/>
  <disable_collisions link1="Arms_Gripper_Ge103In_left_active_link1" link2="Arms_Gripper_Ge103In_left_active_link2" reason="Adjacent"/>
  <disable_collisions link1="Arms_Gripper_Ge103In_left_active_link1" link2="left_link7" reason="Adjacent"/>
  <disable_collisions link1="Arms_Gripper_Ge103In_left_passive_link" link2="left_link7" reason="Adjacent"/>
  <disable_collisions link1="Arms_base_link" link2="SteeringChassis_base_link" reason="Adjacent"/>
  <disable_collisions link1="Arms_base_link" link2="base_link" reason="Adjacent"/>
  <disable_collisions link1="Arms_base_link" link2="head_link1" reason="Adjacent"/>
  <disable_collisions link1="Arms_base_link" link2="left_link1" reason="Adjacent"/>
  <disable_collisions link1="Arms_base_link" link2="right_link1" reason="Adjacent"/>
  <disable_collisions link1="Arms_base_link" link2="torso_lift_link1" reason="Adjacent"/>
  <disable_collisions link1="SteeringChassis_base_link" link2="base_link" reason="Adjacent"/>
  <disable_collisions link1="SteeringChassis_base_link" link2="torso_lift_link1" reason="Adjacent"/>
  <disable_collisions link1="SteeringChassis_base_link" link2="wheel_steering_link1" reason="Adjacent"/>
  <disable_collisions link1="SteeringChassis_base_link" link2="wheel_steering_link2" reason="Adjacent"/>
  <disable_collisions link1="SteeringChassis_base_link" link2="wheel_steering_link3" reason="Adjacent"/>
  <disable_collisions link1="SteeringChassis_base_link" link2="wheel_steering_link4" reason="Adjacent"/>
  <disable_collisions link1="base_link" link2="torso_lift_link1" reason="Adjacent"/>
  <disable_collisions link1="base_link" link2="wheel_steering_link1" reason="Adjacent"/>
  <disable_collisions link1="base_link" link2="wheel_steering_link2" reason="Adjacent"/>
  <disable_collisions link1="base_link" link2="wheel_steering_link3" reason="Adjacent"/>
  <disable_collisions link1="base_link" link2="wheel_steering_link4" reason="Adjacent"/>
  <disable_collisions link1="head_link1" link2="head_link2" reason="Adjacent"/>
  <disable_collisions link1="head_link1" link2="torso_lift_link1" reason="Adjacent"/>
  <disable_collisions link1="left_link1" link2="left_link2" reason="Adjacent"/>
  <disable_collisions link1="left_link1" link2="torso_lift_link1" reason="Adjacent"/>
  <disable_collisions link1="left_link2" link2="left_link3" reason="Adjacent"/>
  <disable_collisions link1="left_link3" link2="left_link4" reason="Adjacent"/>
  <disable_collisions link1="left_link4" link2="left_link5" reason="Adjacent"/>
  <disable_collisions link1="left_link5" link2="left_link6" reason="Adjacent"/>
  <disable_collisions link1="left_link6" link2="left_link7" reason="Adjacent"/>
  <disable_collisions link1="right_link1" link2="right_link2" reason="Adjacent"/>
  <disable_collisions link1="right_link1" link2="torso_lift_link1" reason="Adjacent"/>
  <disable_collisions link1="right_link2" link2="right_link3" reason="Adjacent"/>
  <disable_collisions link1="right_link3" link2="right_link4" reason="Adjacent"/>
  <disable_collisions link1="right_link4" link2="right_link5" reason="Adjacent"/>
  <disable_collisions link1="right_link5" link2="right_link6" reason="Adjacent"/>
  <disable_collisions link1="right_link6" link2="right_link7" reason="Adjacent"/>
  <disable_collisions link1="wheel_driving_link1" link2="wheel_steering_link1" reason="Adjacent"/>
  <disable_collisions link1="wheel_driving_link2" link2="wheel_steering_link2" reason="Adjacent"/>
  <disable_collisions link1="wheel_driving_link3" link2="wheel_steering_link3" reason="Adjacent"/>
  <disable_collisions link1="wheel_driving_link4" link2="wheel_steering_link4" reason="Adjacent"/>
  <disable_collisions link1="Arms_Gripper_Ge103In_Right_base_link" link2="Arms_Gripper_Ge103In_Right_left_active_link2" reason="Linkage"/>
  <disable_collisions link1="Arms_Gripper_Ge103In_Right_left_active_link1" link2="Arms_Gripper_Ge103In_Right_left_passive_link" reason="Linkage"/>
  <disable_collisions link1="Arms_Gripper_Ge103In_Right_left_active_link2" link2="Arms_Gripper_Ge103In_Right_left_passive_link" reason="Linkage"/>
  <disable_collisions link1="Arms_Gripper_Ge103In_base_link" link2="Arms_Gripper_Ge103In_left_active_link2" reason="Linkage"/>
  <disable_collisions link1="Arms_Gripper_Ge103In_left_active_link1" link2="Arms_Gripper_Ge103In_left_passive_link" reason="Linkage"/>
  <disable_collisions link1="Arms_Gripper_Ge103In_left_active_link2" link2="Arms_Gripper_Ge103In_left_passive_link" reason="Linkage"/>
  <disable_collisions link1="SteeringChassis_base_link" link2="wheel_driving_link1" reason="Always"/>
  <disable_collisions link1="SteeringChassis_base_link" link2="wheel_driving_link2" reason="Always"/>
  <disable_collisions link1="SteeringChassis_base_link" link2="wheel_driving_link3" reason="Always"/>
  <disable_collisions link1="SteeringChassis_base_link" link2="wheel_driving_link4" reason="Always"/>
  <disable_collisions link1="left_link5" link2="left_link7" reason="Always"/>
  <disable_collisions link1="right_link5" link2="right_link7" reason="Always"/>
  <disable_collisions link1="head_link2" link2="torso_lift_link1" reason="Default"/>
  <!-- 15 Oct (user approved): the vendor model puts the right gripper's finger pivots ~4 cm from the flange (the left
       mount is turned 180 deg, the right not), so a closed right finger's hull swings back into the forearm; the real
       finger cannot reach it. Rack, frame and other-arm collisions stay checked. Keep when regenerating. -->
  <disable_collisions link1="Arms_Gripper_Ge103In_Right_left_active_link1" link2="right_link5" reason="Model"/>
  <disable_collisions link1="Arms_Gripper_Ge103In_Right_left_active_link1" link2="right_link6" reason="Model"/>
  <disable_collisions link1="Arms_Gripper_Ge103In_Right_left_active_link2" link2="right_link5" reason="Model"/>
  <disable_collisions link1="Arms_Gripper_Ge103In_Right_left_active_link2" link2="right_link6" reason="Model"/>
  <disable_collisions link1="Arms_Gripper_Ge103In_Right_left_active_link2" link2="right_link7" reason="Model"/>
  <disable_collisions link1="Arms_Gripper_Ge103In_Right_left_passive_link" link2="right_link5" reason="Model"/>
  <disable_collisions link1="Arms_Gripper_Ge103In_Right_left_passive_link" link2="right_link6" reason="Model"/>
  <!-- end of disabled collisions -->
</robot>
