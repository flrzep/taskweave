<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypelocation="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>taskweave_hmi</name>
  <version>0.2.1</version>
  <description>Web HMI for taskweave: live mission status, control and a validated mission editor.</description>
  <maintainer email="f.rzepczyk@gmail.com">Florian Rzepczyk</maintainer>
  <license>TBD</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>std_srvs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>rcl_interfaces</exec_depend>
  <exec_depend>taskweave_core</exec_depend>
  <exec_depend>taskweave_interfaces</exec_depend>
  <exec_depend>taskweave_skills</exec_depend>   <!-- nav2_parameters -->
  <exec_depend>python3-ruamel.yaml</exec_depend>
  <exec_depend>python3-jsonschema</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>moveit_msgs</exec_depend>   <!-- GetPositionFK (server.py) -->
  <exec_depend>simulation_interfaces</exec_depend>   <!-- recording: reset the simulation (SetSimulationState) -->
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
