<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypelocation="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>taskweave_core</name>
  <version>0.1.0</version>
  <description>taskweave core: config loading and validation, planners, the task handler and the skill server base class.</description>
  <maintainer email="f.rzepczyk@gmail.com">Florian Rzepczyk</maintainer>
  <license>TBD</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>taskweave_interfaces</exec_depend>
  <exec_depend>std_srvs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>python3-jsonschema</exec_depend>
  <exec_depend>python3-ruamel.yaml</exec_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
